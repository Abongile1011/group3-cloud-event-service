# Copy to .env and adjust. Placeholder values only, no real secrets.
SUBMISSIONS_TABLE=StudentSubmissions
UPLOAD_BUCKET=student-submission-uploads
# Use http://host.docker.internal:8000 under SAM Local (Docker),
# and http://localhost:8000 when running scripts or tests directly on the host.
DYNAMODB_ENDPOINT=http://localhost:8000
LOCAL_STORAGE_PATH=local-storage
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_DEFAULT_REGION=af-south-1
